---
// Общая оболочка для новости и статьи блога
interface Crumb { href?: string; label: string }
interface Props {
  eyebrow: string;
  title: string;
  date: Date;
  crumbs: Crumb[];
  meta?: string[];
  example?: boolean;
}
const { eyebrow, title, date, crumbs, meta = [], example = false } = Astro.props;
const dateText = date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<div class="progress" aria-hidden="true"><span data-progress></span></div>
<header class="a-hero">
  <div class="wrap a-head">
    <nav class="crumbs" aria-label="Навигация по разделам" data-intro>
      <a href="/">Главная</a>
      {crumbs.map((c) => (
        <>
          <span aria-hidden="true">/</span>
          {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        </>
      ))}
    </nav>
    <div class="a-meta" data-intro>
      <span class="chip">{eyebrow}</span>
      {example && <span class="chip chip-example">Пример</span>}
      <time datetime={date.toISOString().slice(0, 10)}>{dateText}</time>
      {meta.map((m) => <span>{m}</span>)}
    </div>
    <h1 class="a-title" data-intro>{title}</h1>
  </div>
</header>
<article class="section a-body">
  <div class="wrap a-grid">
    <div class="prose a-prose" data-reveal="fade">
      <slot />
    </div>
    <aside class="a-aside">
      <slot name="aside" />
    </aside>
  </div>
</article>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 60; pointer-events: none; }
  .progress span { display: block; height: 100%; background: var(--gold); transform: scaleX(0); transform-origin: left; }
  .a-hero { padding-block: calc(var(--header-h) + clamp(48px, 7vw, 100px)) clamp(40px, 5vw, 64px); background: radial-gradient(800px 420px at 90% 0%, rgba(45, 86, 196, 0.45), transparent 60%), var(--arena); border-bottom: 1px solid var(--line-soft); }
  .a-head { display: grid; gap: 22px; max-width: 1040px; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 10px; font: 600 15px/1 var(--f-sport); letter-spacing: 0.14em; text-transform: uppercase; color: var(--mist); }
  .crumbs a { color: var(--mist); text-decoration: none; }
  .crumbs a:hover { color: var(--gold-hi); }
  .crumbs [aria-current] { color: var(--ivory); }
  .a-meta { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; font: 700 14px/1 var(--f-sport); letter-spacing: 0.16em; text-transform: uppercase; color: var(--mist); }
  .a-title { font: 800 clamp(44px, 7vw, 96px)/0.9 var(--f-sport); text-transform: uppercase; }
  .a-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .a-prose { font-size: 18px; }
  .a-prose :global(p:first-of-type) { font: 500 italic clamp(22px, 2.4vw, 27px)/1.4 var(--f-display); color: var(--ivory); }
  .a-aside { position: sticky; top: calc(var(--header-h) + 24px); display: grid; gap: 18px; }
  .a-aside:empty { display: none; }
  @media (max-width: 900px) { .a-grid { grid-template-columns: 1fr; } .a-aside { position: static; } }
</style>
