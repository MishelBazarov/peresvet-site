---
// Карточка тренера или бойца. Пока нет фото — инициалы и пометка «фото скоро».
interface Props {
  href: string;
  name: string;
  role?: string;
  regalia?: string[];
  photo?: string;
  large?: boolean;
  arena?: boolean;
}
const { href, name, role, regalia = [], photo, large = false, arena = false } = Astro.props;
const parts = name.split(' ');
const initials = parts.slice(0, 2).map((p) => p[0]).join('');
const [last, ...rest] = parts;
---

<a href={href} class:list={['person', { large, arena }]} data-reveal>
  <div class="p-photo">
    {photo ? (
      <img src={photo} alt={name} loading="lazy" />
    ) : (
      <div class="p-ph" aria-hidden="true">
        <span class="p-initials">{initials}</span>
        <span class="p-note">фото скоро</span>
      </div>
    )}
    {regalia.length > 0 && (
      <ul class="p-badges">
        {regalia.slice(0, 2).map((r) => <li>{r}</li>)}
      </ul>
    )}
  </div>
  <div class="p-info">
    <h3 class="p-name"><span>{last}</span> {rest.join(' ')}</h3>
    {role && <p class="p-role">{role}</p>}
  </div>
</a>

<style>
  .person { display: grid; gap: 18px; text-decoration: none; color: var(--ivory); min-width: 0; }
  .p-photo { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--night-2); border: 1px solid var(--line-soft); transition: border-color 0.4s; }
  .person:hover .p-photo { border-color: var(--line); }
  .person.large .p-photo { aspect-ratio: 4 / 4.4; }
  .p-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .person:hover .p-photo img { transform: scale(1.04); }
  .p-ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(170deg, var(--night-3), var(--night) 75%);
  }
  .person.arena .p-ph { background: linear-gradient(170deg, #141b2b, var(--arena) 75%); }
  .p-initials { font: 500 italic clamp(72px, 9vw, 120px)/1 var(--f-display); color: rgba(232, 205, 140, 0.55); transition: color 0.5s, transform 0.8s var(--ease); }
  .person:hover .p-initials { color: var(--gold-hi); transform: translateY(-6px); }
  .p-note { position: absolute; right: 16px; top: 14px; font: 500 22px/1 var(--f-hand); color: var(--mist); transform: rotate(-4deg); }
  .p-badges { position: absolute; left: 14px; right: 14px; bottom: 14px; list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .p-badges li { font: 700 12.5px/1.2 var(--f-sport); letter-spacing: 0.12em; text-transform: uppercase; padding: 7px 9px 6px; background: rgba(5, 7, 13, 0.78); border: 1px solid var(--line); color: var(--gold-hi); }
  .p-info { display: grid; gap: 6px; }
  .p-name { font: 600 clamp(24px, 2.2vw, 30px)/1.1 var(--f-display); transition: color 0.3s; }
  .person:hover .p-name { color: var(--gold-hi); }
  .person.large .p-name { font-size: clamp(30px, 3vw, 40px); }
  .person.arena .p-name { font: 800 clamp(28px, 2.6vw, 36px)/0.95 var(--f-sport); text-transform: uppercase; }
  .p-name span { color: var(--gold-hi); }
  .p-role { color: var(--mist); font-size: 15px; }
</style>
