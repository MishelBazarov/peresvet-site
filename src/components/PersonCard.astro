---
// Карточка тренера или бойца. Пока нет фото — гербовая заглушка с инициалами.
import StarRing from './StarRing.astro';
interface Props {
  href: string;
  name: string;
  role?: string;
  regalia?: string[];
  photo?: string;
  large?: boolean;
  arena?: boolean;
}
const { href, name, role, regalia = [], photo, large = false, arena = false } = Astro.props;
const parts = name.split(' ');
const initials = parts.slice(0, 2).map((p) => p[0]).join('');
const [last, ...rest] = parts;
---

<a href={href} class:list={['person', { large, arena }]} data-reveal>
  <div class="p-photo">
    {photo ? (
      <img src={photo} alt={name} loading="lazy" />
    ) : (
      <div class="p-ph" aria-hidden="true">
        <StarRing count={12} size={3.6} class="p-ring" />
        <span class="p-initials">{initials}</span>
      </div>
    )}
    {regalia.length > 0 && (
      <ul class="p-badges">
        {regalia.slice(0, 2).map((r) => <li>{r}</li>)}
      </ul>
    )}
  </div>
  <div class="p-info">
    <h3 class="p-name"><span>{last}</span> {rest.join(' ')}</h3>
    {role && <p class="p-role">{role}</p>}
    <span class="p-more" aria-hidden="true">Подробнее →</span>
  </div>
</a>

<style>
  .person { display: grid; gap: 20px; text-decoration: none; color: var(--ivory); min-width: 0; }
  .p-photo { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--night-2); border: 1px solid var(--line-soft); }
  .person.large .p-photo { aspect-ratio: 4 / 4.4; }
  .p-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease), filter 0.6s; filter: grayscale(0.2); }
  .person:hover .p-photo img { transform: scale(1.04); filter: none; }
  .p-ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 40%, rgba(45, 86, 196, 0.55), transparent 65%),
      linear-gradient(180deg, var(--night-3), var(--night));
  }
  .person.arena .p-ph { background: radial-gradient(circle at 50% 40%, rgba(201, 165, 92, 0.18), transparent 60%), linear-gradient(180deg, #121826, var(--arena)); }
  .p-ph :global(.p-ring) { position: absolute; width: 78%; color: var(--silver); opacity: 0.35; transition: transform 1.4s var(--ease), opacity 0.6s; }
  .person:hover .p-ph :global(.p-ring) { transform: rotate(30deg); opacity: 0.6; }
  .p-initials { font: 600 clamp(64px, 8vw, 104px)/1 var(--f-display); color: var(--gold); letter-spacing: 0.04em; }
  .p-badges { position: absolute; left: 14px; right: 14px; bottom: 14px; list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .p-badges li { font: 700 12.5px/1.2 var(--f-sport); letter-spacing: 0.12em; text-transform: uppercase; padding: 7px 9px 6px; background: rgba(5, 7, 13, 0.78); border: 1px solid var(--line); color: var(--gold-hi); backdrop-filter: blur(4px); }
  .p-info { display: grid; gap: 6px; }
  .p-name { font: 600 clamp(24px, 2.2vw, 30px)/1.1 var(--f-display); }
  .person.large .p-name { font-size: clamp(30px, 3vw, 40px); }
  .person.arena .p-name { font: 800 clamp(28px, 2.6vw, 36px)/0.95 var(--f-sport); text-transform: uppercase; }
  .p-name span { color: var(--gold-hi); }
  .p-role { color: var(--mist); font-size: 15px; }
  .p-more { font: 700 14px/1 var(--f-sport); letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold); margin-top: 6px; opacity: 0; transform: translateX(-8px); transition: opacity 0.4s, transform 0.4s var(--ease); }
  .person:hover .p-more, .person:focus-visible .p-more { opacity: 1; transform: none; }
  @media (hover: none) { .p-more { opacity: 1; transform: none; } }
</style>
