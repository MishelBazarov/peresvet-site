---
// Герб клуба, как на флаге: шесть гранёных серебряных звёзд по кругу и Пересвет на коне.
// Кольцо медленно вращается, звёзды остаются ровными и иногда поблёскивают.
//
// Производительность: каждая звезда — отдельный слой, вращение делает CSS-transform
// (считает видеокарта, без перерисовки). Всадник — неподвижная картинка, рисуется один раз.
// Не возвращать SVG-анимацию и фильтры поверх всадника — это перерисовка на каждом кадре и лаги.
interface Props {
  class?: string;
  stars?: number;
  starR?: number; // внешний радиус звезды, % от стороны герба
  ringR?: number; // радиус кольца звёзд, %
  gap?: number; // зазор между звёздами и фигурой, %
  spin?: boolean;
  label?: string;
}
const { class: cls = '', stars = 6, starR = 7.4, ringR = 43.5, gap = 1.6, spin = true, label } = Astro.props;

// public/brand/horseman.svg: viewBox и описанный круг фигуры (посчитаны по контурам файла)
const VB = { x: 26, y: 23, w: 1462, h: 1605 };
const MEC = { cx: 741.5, cy: 813.6, r: 1056.2 };
const k = (ringR - starR - gap) / MEC.r;
const fig = { w: VB.w * k, x: 50 - (MEC.cx - VB.x) * k, y: 50 - (MEC.cy - VB.y) * k };

// Пятиконечная звезда из 10 граней: у каждого луча светлая и тёмная сторона, свет слева сверху
const deg = Math.PI / 180;
const LIGHT = -125 * deg;
const inner = 0.42;
const pt = (a: number, r: number) => [r * Math.cos(a), r * Math.sin(a)];
const f3 = (v: number) => v.toFixed(3);
const mix = (t: number) => {
  const dark = [92, 104, 128], light = [246, 248, 252];
  return `rgb(${dark.map((d, i) => Math.round(d + (light[i] - d) * t)).join(',')})`;
};
const facets: { d: string; fill: string }[] = [];
for (let i = 0; i < 5; i++) {
  const ao = (-90 + 72 * i) * deg;
  const [ox, oy] = pt(ao, 1);
  for (const side of [-1, 1]) {
    const [px, py] = pt(ao + side * 36 * deg, inner);
    const t = 0.5 + 0.5 * Math.cos(ao + side * 90 * deg - LIGHT);
    facets.push({ d: `M0 0L${f3(px)} ${f3(py)}L${f3(ox)} ${f3(oy)}Z`, fill: mix(0.15 + 0.85 * t) });
  }
}
const outline = 'M' + Array.from({ length: 10 }, (_, i) => pt((-90 + 36 * i) * deg, i % 2 ? inner : 1).map(f3).join(' ')).join('L') + 'Z';

// Слой звезды чуть больше самой звезды, чтобы поместилась тень
const PAD = 1.35;
const box = 2 * PAD * starR;
const points = Array.from({ length: stars }, (_, i) => {
  const a = (i / stars) * Math.PI * 2 - Math.PI / 2;
  return { x: 50 + ringR * Math.cos(a) - box / 2, y: 50 + ringR * Math.sin(a) - box / 2, delay: (i * 1.17).toFixed(2) };
});
const vb = `${-PAD} ${-PAD} ${2 * PAD} ${2 * PAD}`;
const uid = Math.random().toString(36).slice(2, 8);
---

<div
  class:list={['emblem', cls, { 'no-spin': !spin }]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <div class="em-ring">
    {points.map((p) => (
      <span class="em-star" style={`left:${p.x.toFixed(2)}%;top:${p.y.toFixed(2)}%;width:${box.toFixed(2)}%;--d:${p.delay}s`}>
        <span class="em-star-in">
          <svg viewBox={vb}>
            <defs>
              <filter id={`s-${uid}`} x="-30%" y="-30%" width="160%" height="160%">
                <feGaussianBlur stdDeviation="0.08" />
              </filter>
            </defs>
            <path d={outline} transform="translate(0.04 0.1)" fill="#020611" opacity="0.55" filter={`url(#s-${uid})`} />
            {facets.map((f) => <path d={f.d} fill={f.fill} />)}
            <path d={outline} fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="0.04" stroke-linejoin="round" />
          </svg>
          <svg viewBox={vb} class="em-glint"><path d={outline} fill="#fff" /></svg>
        </span>
      </span>
    ))}
  </div>
  <img class="em-horse" src="/brand/horseman.svg" alt="" decoding="async" style={`left:${fig.x.toFixed(2)}%;top:${fig.y.toFixed(2)}%;width:${fig.w.toFixed(2)}%`} />
</div>

<style>
  .emblem { --dur: 120s; position: relative; width: 100%; aspect-ratio: 1; }
  .em-ring { position: absolute; inset: 0; animation: em-spin var(--dur) linear infinite; will-change: transform; }
  .em-star { position: absolute; aspect-ratio: 1; }
  .em-star-in { position: absolute; inset: 0; animation: em-spin var(--dur) linear infinite reverse; will-change: transform; }
  .em-star-in svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .em-glint { opacity: 0; animation: em-glint 7s ease-in-out var(--d) infinite; will-change: opacity; }
  .em-horse { position: absolute; height: auto; filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.35)); }
  .no-spin .em-ring, .no-spin .em-star-in { animation: none; }
  @keyframes em-spin { to { transform: rotate(360deg); } }
  @keyframes em-glint { 0%, 80% { opacity: 0; } 88% { opacity: 0.5; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .em-ring, .em-star-in, .em-glint { animation: none !important; }
  }
</style>
