---
// Пересвет на коне — фигура с флага клуба (без кольца звёзд)
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<img class:list={['horseman', cls]} src="/brand/horseman.svg" alt="" width="1462" height="1605" decoding="async" />

<style>
  .horseman { display: block; width: 100%; height: auto; }
</style>
