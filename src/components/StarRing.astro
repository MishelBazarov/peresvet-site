---
// Кольцо серебряных звёзд с флага клуба. Рисуется при сборке, без JS.
interface Props {
  count?: number;
  radius?: number; // в процентах от половины стороны
  size?: number; // размер звезды в единицах viewBox (100×100)
  class?: string;
}
const { count = 12, radius = 44, size = 3.4, class: cls = '' } = Astro.props;
const star = 'M0 -1Q.13 -.13 1 0Q.13 .13 0 1Q-.13 .13 -1 0Q-.13 -.13 0 -1Z';
const stars = Array.from({ length: count }, (_, i) => {
  const a = (i / count) * Math.PI * 2 - Math.PI / 2;
  return { x: 50 + radius * Math.cos(a), y: 50 + radius * Math.sin(a) };
});
---

<svg class:list={['star-ring', cls]} viewBox="0 0 100 100" aria-hidden="true">
  {stars.map((s) => (
    <path d={star} transform={`translate(${s.x.toFixed(2)} ${s.y.toFixed(2)}) rotate(45) scale(${size})`} fill="currentColor" />
  ))}
</svg>
