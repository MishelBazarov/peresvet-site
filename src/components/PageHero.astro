---
import Ornament from './Ornament.astro';
interface Crumb { href?: string; label: string }
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  arena?: boolean;
}
const { eyebrow, title, lead, crumbs = [], arena = false } = Astro.props;
// надзаголовок пишется «от руки», со строчной буквы
const note = eyebrow.charAt(0).toLowerCase() + eyebrow.slice(1);
---

<header class:list={['page-hero', { arena }]}>
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Навигация по разделам" data-intro>
        <a href="/">Главная</a>
        {crumbs.map((c) => (
          <>
            <span aria-hidden="true">/</span>
            {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </>
        ))}
      </nav>
    )}
    <span class="eyebrow" data-intro>{note}</span>
    <h1 class:list={[arena ? 'arena-title' : 'h1 gold-text']} data-intro>{title}</h1>
    {lead && <p class="lead" data-intro>{lead}</p>}
    <slot />
  </div>
  <Ornament class="ph-ornament" cell={4} />
</header>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: calc(var(--header-h) + clamp(48px, 8vw, 104px)) 0;
    background:
      radial-gradient(900px 520px at 85% 0%, rgba(45, 86, 196, 0.5), transparent 62%),
      var(--night);
  }
  .page-hero.arena { background: radial-gradient(800px 460px at 90% 0%, rgba(45, 86, 196, 0.32), transparent 62%), var(--arena); }
  .page-hero .wrap { position: relative; display: grid; gap: 20px; justify-items: start; padding-bottom: clamp(44px, 6vw, 80px); }
  .page-hero :global(.ph-ornament) { opacity: 0.85; }
  .lead { max-width: 40ch; }
  .arena-title {
    font: 800 clamp(56px, 10vw, 136px)/0.86 var(--f-sport);
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .crumbs { display: flex; flex-wrap: wrap; gap: 10px; font: 600 15px/1 var(--f-sport); letter-spacing: 0.14em; text-transform: uppercase; color: var(--mist); }
  .crumbs a { color: var(--mist); text-decoration: none; }
  .crumbs a:hover { color: var(--gold-hi); }
  .crumbs [aria-current] { color: var(--ivory); }
</style>
