---
import Base from '../layouts/Base.astro';
import Emblem from '../components/Emblem.astro';
---

<Base title="Страница не найдена" description="Такой страницы на сайте «Пересвета» нет.">
  <section class="nf">
    <div class="nf-emblem"><Emblem /></div>
    <p class="nf-code sport">404</p>
    <h1 class="h2">Такой страницы нет</h1>
    <p class="muted">Возможно, ссылка устарела. Начните с главной.</p>
    <a href="/" class="btn btn-gold">На главную</a>
  </section>
</Base>

<style>
  .nf { min-height: 100svh; display: grid; place-content: center; justify-items: center; text-align: center; gap: 18px; padding: calc(var(--header-h) + 40px) var(--gutter) 80px; }
  .nf-emblem { width: 220px; }
  .nf-code { font-size: 96px; line-height: 0.8; font-weight: 800; color: var(--gold-hi); }
</style>
