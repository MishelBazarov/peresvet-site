---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Soon from '../components/Soon.astro';
import { club, halls } from '../data/site';
---

<Base title="Залы и расписание" description="Адреса залов центра «Пересвет» в Армавире: ул. Володарского, 55 и Дом офицеров на ул. Советской Армии, 210А. Группы для детей с 5 лет, подростков и взрослых.">
  <PageHero eyebrow="Где заниматься" title="Залы" lead="Тренировки в двух залах Армавира. Группы по возрасту и уровню подготовки." crumbs={[{ label: 'Залы и расписание' }]} />

  <section class="section">
    <div class="wrap halls">
      {halls.map((h) => (
        <article class="hall" data-reveal>
          <div class="hall-map" aria-hidden="true">
            <svg viewBox="0 0 100 60" preserveAspectRatio="none"><path d="M0 40 L30 34 L55 44 L100 30" stroke="currentColor" stroke-width=".4" fill="none" /><path d="M10 0 L22 60 M70 0 L62 60 M0 18 L100 12" stroke="currentColor" stroke-width=".25" fill="none" /></svg>
            <span class="pin"></span>
          </div>
          <div class="hall-body">
            <div class="hall-top">
              <span class="sport">Армавир</span>
              {h.isNew && <span class="chip chip-new">Новый адрес</span>}
            </div>
            <h2 class="h3">{h.name}</h2>
            <p class="addr">{h.address}</p>
            {h.note && <p class="muted">{h.note}</p>}
            <div class="links">
              <a class="link-arrow" href={h.yandex} target="_blank" rel="noopener">Яндекс Карты <span>↗</span></a>
              {h.gis && <a class="link-arrow" href={h.gis} target="_blank" rel="noopener">2ГИС <span>↗</span></a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-banner">
    <div class="wrap two">
      <div class="sec-head">
        <span class="eyebrow" data-reveal>Группы</span>
        <h2 class="h2" data-reveal>Кого принимаем</h2>
      </div>
      <div class="groups">
        <div class="group" data-reveal><b class="sport">{club.minAge}–7</b><span>Младшая группа: игровая форма, акробатика, координация</span></div>
        <div class="group" data-reveal><b class="sport">8–15</b><span>Дети и подростки: техника, спарринги, первые соревнования</span></div>
        <div class="group" data-reveal><b class="sport">16+</b><span>Старшие и взрослые: спорт и рукопашный бой для себя</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div class="sec-head">
        <span class="eyebrow" data-reveal>Расписание</span>
        <h2 class="h2" data-reveal>Когда тренировки</h2>
      </div>
      <div class="col">
        <div data-reveal><Soon text="Таблица по залам и группам: дни недели, время, тренер. Пока точное время подскажем по телефону." /></div>
        <div class="call" data-reveal>
          <a class="call-phone" href={club.phoneHref}>{club.phone}</a>
          <button type="button" class="btn btn-gold" data-open-lead>Оставить заявку</button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .halls { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(18px, 2.4vw, 32px); }
  .hall { border: 1px solid var(--line-soft); background: var(--night-2); display: grid; min-width: 0; transition: border-color 0.4s; }
  .hall:hover { border-color: var(--line); }
  .hall-map { position: relative; aspect-ratio: 16 / 7; background: radial-gradient(circle at 50% 55%, rgba(45, 86, 196, 0.5), transparent 60%), var(--night-3); color: rgba(201, 209, 227, 0.4); overflow: hidden; border-bottom: 1px solid var(--line-soft); }
  .hall-map svg { width: 100%; height: 100%; }
  .pin { position: absolute; left: 50%; top: 52%; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 8px rgba(201, 165, 92, 0.2), 0 0 0 18px rgba(201, 165, 92, 0.08); }
  .hall-body { padding: clamp(22px, 3vw, 36px); display: grid; gap: 12px; }
  .hall-top { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
  .hall-top .sport { font-weight: 700; font-size: 14px; letter-spacing: 0.2em; color: var(--mist); }
  .addr { font: 800 clamp(28px, 3vw, 38px)/1 var(--f-sport); text-transform: uppercase; }
  .links { display: flex; gap: 24px; flex-wrap: wrap; margin-top: 8px; }
  .two { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(28px, 5vw, 80px); align-items: start; }
  .groups { display: grid; }
  .group { display: grid; grid-template-columns: 140px 1fr; gap: 20px; align-items: baseline; padding-block: 22px; border-top: 1px solid var(--line-soft); }
  .group b { font-size: clamp(44px, 5vw, 64px); line-height: 0.9; font-weight: 800; color: var(--gold-hi); }
  .group span { color: var(--ivory); }
  .col { display: grid; gap: 24px; }
  .call { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; }
  .call-phone { font: 800 clamp(32px, 4vw, 48px)/1 var(--f-sport); color: var(--ivory); text-decoration: none; }
  @media (max-width: 860px) { .halls, .two { grid-template-columns: 1fr; } .group { grid-template-columns: 100px 1fr; } }
</style>
