---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Soon from '../components/Soon.astro';
import { club, halls } from '../data/site';
const single = halls.length === 1;
---

<Base title="Зал и расписание" description={`Где проходят тренировки центра «Пересвет» в Армавире: ${halls.map((h) => h.address).join('; ')}. Группы для детей с ${club.minAge} лет, подростков и взрослых.`}>
  <PageHero
    eyebrow="где заниматься"
    title={single ? 'Зал' : 'Залы'}
    lead={single ? `Тренировки проходят в зале на ${halls[0].address.replace('ул. ', 'улице ')}.` : 'Тренировки в залах Армавира.'}
    crumbs={[{ label: single ? 'Зал и расписание' : 'Залы и расписание' }]}
  />

  <section class="section">
    <div class:list={['wrap', 'halls', { single }]}>
      {halls.map((h) => (
        <article class="hall" data-reveal>
          <div class="hall-map" aria-hidden="true">
            <svg viewBox="0 0 400 220" preserveAspectRatio="xMidYMid slice">
              <path d="M-10 150C60 140 120 130 190 148S330 170 410 130" class="m-river" />
              <path d="M40 -10L80 230M250 -10L210 230M-10 60L410 44M-10 196L410 182M330 -10L360 230" class="m-road" />
              <path d="M120 -10L150 230M-10 104L410 96" class="m-street" />
            </svg>
            <span class="pin"></span>
            <span class="pin-label hand">мы здесь</span>
          </div>
          <div class="hall-body">
            {h.isNew && <span class="hall-new hand">новый зал!</span>}
            <h2 class="addr">{h.address}</h2>
            {h.note && <p class="muted">{h.note}, {club.city}</p>}
            <div class="links">
              <a class="link-arrow" href={h.yandex} target="_blank" rel="noopener">Яндекс Карты <span>↗</span></a>
              {h.gis && <a class="link-arrow" href={h.gis} target="_blank" rel="noopener">2ГИС <span>↗</span></a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-banner">
    <div class="wrap two">
      <div class="sec-head">
        <span class="eyebrow" data-reveal>группы</span>
        <h2 class="h2" data-reveal>Кого принимаем</h2>
      </div>
      <div class="groups">
        <div class="group" data-reveal><b class="sport">{club.minAge}–7</b><span>Дети младшего возраста, мальчики и девочки</span></div>
        <div class="group" data-reveal><b class="sport">8–15</b><span>Школьники и подростки</span></div>
        <div class="group" data-reveal><b class="sport">16+</b><span>Старшие и взрослые</span></div>
        <p class="hand groups-note" data-reveal>точное деление на группы подскажет тренер</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div class="sec-head">
        <span class="eyebrow" data-reveal>расписание</span>
        <h2 class="h2" data-reveal>Когда тренировки</h2>
      </div>
      <div class="col">
        <div data-reveal><Soon text="Таблица по группам: дни недели, время, тренер. Пока точное время подскажем по телефону." /></div>
        <div class="call" data-reveal>
          <a class="call-phone" href={club.phoneHref}>{club.phone}</a>
          <button type="button" class="btn btn-gold" data-open-lead>Оставить заявку</button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .halls { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(18px, 2.4vw, 32px); }
  .halls.single { grid-template-columns: 1fr; }
  .hall { border: 1px solid var(--line-soft); background: var(--night-2); display: grid; min-width: 0; }
  .single .hall { grid-template-columns: 1.2fr 0.8fr; }
  .hall-map { position: relative; aspect-ratio: 400 / 220; background: radial-gradient(circle at 52% 52%, rgba(45, 86, 196, 0.55), transparent 62%), var(--night-3); overflow: hidden; }
  .hall-map svg { width: 100%; height: 100%; }
  .m-road { stroke: rgba(201, 209, 227, 0.28); stroke-width: 6; fill: none; }
  .m-street { stroke: rgba(201, 209, 227, 0.16); stroke-width: 3; fill: none; }
  .m-river { stroke: rgba(74, 111, 214, 0.55); stroke-width: 14; fill: none; stroke-linecap: round; }
  .pin { position: absolute; left: 52%; top: 50%; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 8px rgba(201, 165, 92, 0.2), 0 0 0 18px rgba(201, 165, 92, 0.08); }
  .pin-label { position: absolute; left: calc(52% + 22px); top: calc(50% - 44px); transform: rotate(-5deg); }
  .hall-body { position: relative; padding: clamp(28px, 4vw, 48px); display: grid; gap: 14px; align-content: center; }
  .hall-new { transform: rotate(-4deg); justify-self: start; }
  .addr { font: 800 clamp(34px, 4vw, 52px)/0.95 var(--f-sport); text-transform: uppercase; }
  .links { display: flex; gap: 24px; flex-wrap: wrap; margin-top: 8px; }
  .two { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(28px, 5vw, 80px); align-items: start; }
  .groups { display: grid; }
  .group { display: grid; grid-template-columns: 140px 1fr; gap: 20px; align-items: baseline; padding-block: 22px; border-top: 1px solid var(--line-soft); }
  .group b { font-size: clamp(44px, 5vw, 64px); line-height: 0.9; font-weight: 800; color: var(--gold-hi); }
  .groups-note { margin-top: 18px; transform: rotate(-2deg); }
  .col { display: grid; gap: 24px; }
  .call { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; }
  .call-phone { font: 800 clamp(32px, 4vw, 48px)/1 var(--f-sport); color: var(--ivory); text-decoration: none; }
  @media (max-width: 860px) {
    .halls, .two, .single .hall { grid-template-columns: 1fr; }
    .group { grid-template-columns: 100px 1fr; }
  }
</style>
